<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro"> 

  <xacro:macro name="base" params="length width height mass wheel_radius wheel_pos_z">
    <link name="base_footprint"/>
    
    <link name="base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${length} ${width} ${height}"/>
        </geometry>
        <material name="yellow">
          <color rgba="0.8784 0.6627 0.6627 1.0"/>
        </material>
      </visual>
      
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${length} ${width} ${height}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${(1/12) * mass * ((width  * width)  + (height * height))}" ixy="0.0" ixz="0.0"
                 iyy="${(1/12) * mass * ((length * length) + (height * height))}" iyz="0.0"
                 izz="${(1/12) * mass * ((length * length) + (width  * width))}"/>
      </inertial>
    </link>

    <gazebo reference="base_link">  
      <visual>  
        <material>
          <ambient>0.8392 0.6314 0.0 1.0</ambient>  
          <diffuse>0.8392 0.6314 0.0 1.0</diffuse>  
          <specular>0.99 0.99 0.99 1.0</specular>  
          <emissive>0.0 0.0 0.0 0.0</emissive>  
        </material>
      </visual> 
    </gazebo>

    <joint name="base_to_footprint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 ${(wheel_radius - wheel_pos_z)}" rpy="0 0 0"/>
    </joint>

    <link name="rasp_link">
    <visual>
      <geometry>
        <box size="${rasp_length} ${rasp_width} ${rasp_height}"/>
      </geometry>
      <material name="Dark Green">
        <color rgba="0 0.4 0 1"/>
      </material>
    </visual>
    
    <collision>
      <geometry>
        <box size="${rasp_length} ${rasp_width} ${rasp_height}"/>
      </geometry>
    </collision>
  </link>
    
  <joint name="rasp_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="rasp_link"/>
    <origin xyz="0.06 0 0.050"/>
  </joint>

  <link name="tower_link">
    <visual>
      <geometry>
        <box size="${tower_length} ${tower_width} ${tower_height}"/>
      </geometry>
      <material name="Dark Grey">
        <color rgba="0.4 0.4 0.4 1"/>
      </material>
    </visual>
    
    <collision>
      <geometry>
        <box size="${tower_length} ${tower_width} ${tower_height}"/>
      </geometry>
    </collision>
  </link>
    
  <joint name="tower_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="tower_link"/>
    <origin xyz="-0.06 0 0.050"/>
  </joint>

  </xacro:macro>
</robot>