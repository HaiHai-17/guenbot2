<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="omni_drive_controller">
    <gazebo>
      <plugin name="gazebo_ros_mecanum_diff_drive" filename="libgazebo_mecanum_drive.so">
        <commandTopic>cmd_vel</commandTopic>
        <odometryTopic>odom</odometryTopic>
        <odometryFrame>odom</odometryFrame>
        <robotBaseFrame>base_footprint</robotBaseFrame>
        <LeftRear>rear_left_wheel_joint</LeftRear>
        <LeftFront>front_left_wheel_joint</LeftFront>
        <RightFront>front_right_wheel_joint</RightFront>
        <RightRear>rear_right_wheel_joint</RightRear>
        <odometryRate>10</odometryRate>      
        <publishWheelTF>true</publishWheelTF>
        <publishWheelJointState>true</publishWheelJointState>
        <WheelTorque>1</WheelTorque>
        <WheelSeparationW>0.17</WheelSeparationW>
        <WheelSeparationL>0.195</WheelSeparationL>
        <wheelAccel>5</wheelAccel>
        <wheelDiameter>0.09</wheelDiameter>
        <publishOdom>false</publishOdom>
        <isRollerModel>true</isRollerModel>
      </plugin>
</gazebo>
  </xacro:macro>
</robot>