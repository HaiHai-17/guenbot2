<?xml version="1.0" encoding="utf-8"?>
<robot name="guenbot2">
  <!-- #############################  BASE-FOOTPRINT  ###############################-->
  <link name="base_footprint"/>
  <!-- #############################  BASE-LINK  ###############################-->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.250 0.150 0.050"/>
      </geometry>
      <material name="Dark Grey">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.250 0.150 0.050"/>
      </geometry>
    </collision>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 -0.05"/>
  </joint>
  <!-- #############################  FRONT-LEFT  ###############################-->
  <link name="wheel_front_left_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/guen/neuronbot2_ros2_ws/src/neuronbot2/neuronbot2_description/meshes/mecanum.dae" scale="0.325 0.325 0.325"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="5.020833333333333e-05" ixy="0" ixz="0" iyy="5.020833333333333e-05" iyz="0" izz="8e-05"/>
    </inertial>
    <surface>
      <friction>
        <ode>
          <mu1>1.5</mu1>
          <mu2>1.5</mu2>
        </ode>
      </friction>
    </surface>
  </link>
  <joint name="wheel_front_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_left_link"/>
    <origin rpy="0 0 0" xyz="0.085 0.0975 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <!-- #############################  FRONT-RIGHT  ###############################-->
  <link name="wheel_front_right_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/guen/neuronbot2_ros2_ws/src/neuronbot2/neuronbot2_description/meshes/mecanum.dae" scale="0.325 0.325 0.325"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="5.020833333333333e-05" ixy="0" ixz="0" iyy="5.020833333333333e-05" iyz="0" izz="8e-05"/>
    </inertial>
    <surface>
      <friction>
        <ode>
          <mu1>1.5</mu1>
          <mu2>1.5</mu2>
        </ode>
      </friction>
    </surface>
  </link>
  <joint name="wheel_front_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_right_link"/>
    <origin rpy="0 0 0" xyz="0.085 -0.0975 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <!-- #############################  BACK-LEFT  ###############################-->
  <link name="wheel_back_left_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/guen/neuronbot2_ros2_ws/src/neuronbot2/neuronbot2_description/meshes/mecanum.dae" scale="0.325 0.325 0.325"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="5.020833333333333e-05" ixy="0" ixz="0" iyy="5.020833333333333e-05" iyz="0" izz="8e-05"/>
    </inertial>
    <surface>
      <friction>
        <ode>
          <mu1>1.5</mu1>
          <mu2>1.5</mu2>
        </ode>
      </friction>
    </surface>
  </link>
  <joint name="wheel_back_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_back_left_link"/>
    <origin rpy="0 0 0" xyz="-0.085 0.0975 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <!-- #############################  BACK-RIGHT  ###############################-->
  <link name="wheel_back_right_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/guen/neuronbot2_ros2_ws/src/neuronbot2/neuronbot2_description/meshes/mecanum.dae" scale="0.325 0.325 0.325"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="5.020833333333333e-05" ixy="0" ixz="0" iyy="5.020833333333333e-05" iyz="0" izz="8e-05"/>
    </inertial>
     <surface>
      <friction>
        <ode>
          <mu1>1.5</mu1>
          <mu2>1.5</mu2>
        </ode>
      </friction>
    </surface>
  </link>
  <joint name="wheel_back_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_back_right_link"/>
    <origin rpy="0 0 0" xyz="-0.085 -0.0975 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <!-- #############################  RASPBERRY  ###############################-->
  <link name="rasp_link">
    <visual>
      <geometry>
        <box size="0.095 0.105 0.040"/>
      </geometry>
      <material name="Dark Green">
        <color rgba="0.0 0.4 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.95 0.105 0.040"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="5.520833333333334e-05" ixy="0.0" ixz="0.0" iyy="8.333333333333333e-05" iyz="0.0" izz="3.1874999999999996e-05"/>
    </inertial>
  </link>
  <joint name="rasp_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rasp_link"/>
    <origin xyz="0.078 0 0.045"/>
  </joint>
  <!-- #############################  TOWER  ###############################-->
  <link name="tower_link">
    <visual>
      <geometry>
        <box size="0.130 0.090 0.050"/>
      </geometry>
      <material name="Dark Green">
        <color rgba="0.0 0.4 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.0130 0.090 0.050"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.00014541666666666666" ixy="0.0" ixz="0.0" iyy="0.00019499999999999997" iyz="0.0" izz="7.041666666666665e-05"/>
    </inertial>
  </link>
  <joint name="tower_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tower_link"/>
    <origin xyz="-0.060 0 0.050"/>
  </joint>
  <!-- #############################  IMU  ###############################-->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0"/>
  </joint>
  <!-- #############################  CAMERA  ###############################-->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.04"/>
      </geometry>
      <material name="Red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.02 0.04"/>
      </geometry>
    </collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="0.115 0 0.085"/>
  </joint>
  <!-- #############################  CAMERA-OPTICAL ###############################-->
  <link name="camera_link_optical"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0.01" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <!-- #############################  LIDAR  ###############################-->
  <link name="lidar_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.07" radius="0.0375"/>
      </geometry>
      <material name="Dark Grey">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.07" radius="0.0375"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="9.437916666666666e-05" ixy="0" ixz="0" iyy="9.437916666666666e-05" iyz="0" izz="0.000140625"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin rpy="0 0 0" xyz="-0.060 0.00 0.109"/>
  </joint>
  <!-- #############################  GAZEBO-IMU ###############################-->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <ros>
          <namespace>/demo</namespace>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
  <!-- #############################  GAZEBO-WHELL ###############################-->
  <gazebo>
      <plugin name="gazebo_ros_mecanum_diff_drive" filename="libgazebo_mecanum_drive.so">
        <commandTopic>cmd_vel</commandTopic>
        <odometryTopic>odom</odometryTopic>
        <odometryFrame>odom</odometryFrame>
        <robotBaseFrame>base_link</robotBaseFrame>
        <LeftRear>wheel_back_left_joint</LeftRear>
        <LeftFront>wheel_front_left_joint</LeftFront>
        <RightFront>wheel_front_right_joint</RightFront>
        <RightRear>wheel_back_right_joint</RightRear>
        <odometryRate>10</odometryRate>      
        <publishWheelTF>true</publishWheelTF>
        <publishWheelJointState>true</publishWheelJointState>
        <WheelTorque>1</WheelTorque>
        <WheelSeparationW>0.17</WheelSeparationW>
        <WheelSeparationL>0.195</WheelSeparationL>
        <wheelAccel>5</wheelAccel>
        <wheelDiameter>0.09</wheelDiameter>
        <publishOdom>true</publishOdom>
        <isRollerModel>true</isRollerModel>
      </plugin>
  </gazebo>
  <!-- <gazebo>
    <plugin name="rosa_controller" filename="libgazebo_ros_omni_drive.so">
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <odometryRate>20.0</odometryRate>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <wheel_radius>0.095</wheel_radius>
      <base_length>0.250</base_length>
      <base_width>0.150</base_width>
      <front_left_joint>wheel_front_left_joint</front_left_joint>
      <front_right_joint>wheel_front_right_joint</front_right_joint>
      <rear_left_joint>wheel_back_left_joint</rear_left_joint>
      <rear_right_joint>wheel_back_right_joint</rear_right_joint>
      <wheel_max_speed> 20.0 </wheel_max_speed>
      <wheel_acceleration> 10.0</wheel_acceleration>
      <joint_config>1 1 -1 -1</joint_config>
    </plugin>
  </gazebo> -->
  <!-- #############################  GAZEBO-LIDAR ###############################-->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.000000</resolution>
            <min_angle>0.000000</min_angle>
            <max_angle>6.280000</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.120000</min>
          <max>10</max>
          <resolution>0.015000</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin filename="libgazebo_ros_ray_sensor.so" name="scan">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <!-- #############################  GAZEBO-CAMERA ###############################-->
  <gazebo reference="camera_link">
        <material>Gazebo/Red</material>
        <sensor name="camera" type="camera">
            <pose> 0 0 0 0 0 0 </pose>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <camera>
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>640</width>
                    <height>480</height>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>8.0</far>
                </clip>
            </camera>
            <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
                <frame_name>camera_link_optical</frame_name>
            </plugin>
        </sensor>
    </gazebo>
</robot>
